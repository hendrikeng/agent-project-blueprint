{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/agent-project-blueprint/policy-manifest.schema.json",
  "title": "Policy Manifest",
  "type": "object",
  "required": [
    "version",
    "mandatorySafetyRules",
    "executionModel",
    "validationPolicy",
    "executionQuality",
    "runControl",
    "memoryPosture",
    "docContract",
    "gitSafetyContract"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "mandatorySafetyRules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "requiredInRuntimeContext"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "statement": {
            "type": "string",
            "minLength": 8
          },
          "requiredInRuntimeContext": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "executionModel": {
      "type": "object",
      "required": [
        "mode",
        "queue",
        "sourceOfTruth"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "minLength": 8
        },
        "queue": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 4
          }
        },
        "sourceOfTruth": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 4
          }
        }
      },
      "additionalProperties": false
    },
    "validationPolicy": {
      "type": "object",
      "required": [
        "fastIteration",
        "fullGate",
        "repoHealth",
        "notes"
      ],
      "properties": {
        "fastIteration": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 4
          }
        },
        "fullGate": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 4
          }
        },
        "repoHealth": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 4
          }
        },
        "notes": {
          "type": "string",
          "minLength": 8
        },
        "closeoutPredictionRef": {
          "type": "string",
          "minLength": 1,
          "description": "Optional. Local verify:fast checks plan closeout against the merge base with this ref, for example origin/dev."
        },
        "ciLintGateCoversChangedFiles": {
          "type": "boolean",
          "description": "Optional. true states that the required fast lint gate checks every file, also the formatting. CI verify:fast then skips lint:changed when that gate runs in the same job."
        },
        "prePushWholeProgram": {
          "type": "boolean",
          "description": "Optional. false leaves the typecheck gate and type-aware lint rules of a feature-branch pre-push to CI. A gated fast-forward to dev or main still runs every check."
        },
        "changedFileObserve": {
          "type": "array",
          "items": { "type": "string", "enum": ["bun-fmt", "oxfmt", "oxlint", "eslint", "ruff-format", "ruff-check"] },
          "description": "Optional. Changed-file tools that report findings without failing, for example during a formatter adoption."
        },
        "changedFileNodeOptions": {
          "type": "object",
          "propertyNames": { "enum": ["oxfmt", "oxlint", "eslint"] },
          "additionalProperties": { "type": "array", "items": { "type": "string", "pattern": "^--" } },
          "description": "Optional. Node options for a changed-file tool, for example {\"eslint\": [\"--max-old-space-size=4096\"]}."
        }
      },
      "additionalProperties": false
    },
    "releasePolicy": {
      "type": "object",
      "description": "Optional. Project-specific release rules.",
      "properties": {
        "requiredPullRequestFields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Optional. More release PR body fields that need a real value, for example Preview URL."
        }
      },
      "additionalProperties": false
    },
    "executionQuality": {
      "type": "object",
      "required": [
        "goalDrivenExecution",
        "simplicityAndScope",
        "assumptionDiscipline"
      ],
      "properties": {
        "goalDrivenExecution": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "simplicityAndScope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "assumptionDiscipline": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 8
          }
        }
      },
      "additionalProperties": false
    },
    "runControl": {
      "type": "object",
      "required": [
        "goalDrivenRunControl",
        "delegationPolicy",
        "runtimeExecutionPolicy",
        "completionAudit"
      ],
      "properties": {
        "goalDrivenRunControl": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "delegationPolicy": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "runtimeExecutionPolicy": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "completionAudit": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 8
          }
        }
      },
      "additionalProperties": false
    },
    "memoryPosture": {
      "type": "object",
      "required": [
        "whatToDo",
        "improveBeforeRearchitecture",
        "doNotAddYet",
        "escalateWhen",
        "safeRule"
      ],
      "properties": {
        "whatToDo": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "improveBeforeRearchitecture": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "doNotAddYet": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "escalateWhen": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "safeRule": {
          "type": "string",
          "minLength": 16
        }
      },
      "additionalProperties": false
    },
    "docContract": {
      "type": "object",
      "required": [
        "canonicalEntryPoints",
        "requiresSameChangeUpdateFor"
      ],
      "properties": {
        "canonicalEntryPoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 4
          }
        },
        "requiresSameChangeUpdateFor": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 4
          }
        }
      },
      "additionalProperties": false
    },
    "gitSafetyContract": {
      "type": "object",
      "required": [
        "forbiddenWithoutExplicitInstruction",
        "notes"
      ],
      "properties": {
        "forbiddenWithoutExplicitInstruction": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "notes": {
          "type": "string",
          "minLength": 8
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
