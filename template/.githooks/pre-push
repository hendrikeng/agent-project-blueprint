#!/bin/sh
# Installed by the package manager install (package.json `prepare` sets core.hooksPath to .githooks).
# Blocks the push when format, lint, or typecheck fails. See docs/ops/automation/LITE_QUICKSTART.md.
if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node is not on PATH, so the push checks cannot run. Start Git from a shell that loads Node (for example nvm or fnm)." >&2
  exit 1
fi
exec node ./scripts/automation/pre-push.mjs "$@"
