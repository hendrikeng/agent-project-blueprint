{
  "schemaVersion": 1,
  "description": "Root-level distribution manifest for syncing the template payload into downstream repositories.",
  "sourceRoot": "template",
  "targetRoot": ".",
  "ownershipMode": "template-sync",
  "downstreamManifestPath": "docs/ops/automation/harness-manifest.json",
  "managedGlobs": [
    "**/*"
  ],
  "projectOwnedGlobs": [
    "*.md",
    ".github/CODEOWNERS",
    ".github/workflows/**",
    "scripts/ci/**",
    "docs/*.md",
    "docs/architecture/**",
    "docs/deploy/**",
    "docs/env/**",
    "docs/exec-plans/**",
    "docs/future/**",
    "docs/generated/**",
    "docs/ops/api/**",
    "docs/ops/releases/release-mapping.md",
    "docs/product-specs/**",
    "docs/references/**",
    "docs/ui/**",
    "docs/governance/architecture-rules.json",
    "docs/governance/doc-checks.config.json",
    "docs/governance/policy-manifest.json",
    "docs/governance/project-gates.json",
    "docs/agent-hardening/evals.config.json"
  ],
  "bootstrapOnlyGlobs": [
    "PLACEHOLDERS.md",
    "package.scripts.fragment.json",
    "scripts/bootstrap-verify.sh",
    "scripts/bootstrap-verify.test.mjs",
    "scripts/check-template-placeholders.mjs",
    "scripts/check-template-placeholders.sh",
    "scripts/check-template-placeholders.test.mjs",
    "scripts/cleanup-bootstrap-artifacts.mjs",
    "scripts/cleanup-bootstrap-artifacts.test.mjs"
  ],
  "excludeGlobs": [
    ".gitignore",
    "docs/ops/automation/harness-manifest.json"
  ]
}
